# xbindkeys config for Cassiopeia speech-to-text on X11/WindowMaker
# Uses faster-whisper + wtype. Toggle records, toggles again to stop + inject.

# Start/stop dictation
"faster-whisper-toggle"
  Mod3 + Shift + space

# Dictation with post-processing
"faster-whisper-postprocess"
  Mod3 + Shift + p

# Cancel current recording
"faster-whisper-cancel"
  Mod3 + Shift + Escape
