{
    "enabled" : true,
    "theme" : {
        "enableGTK": true
    },
    "toggles": {
        "ai": {
            "aichat": {
                "enable": true,
                "match": [{ "class": "aichat", "workspace": { "name": "special:ai" } }],
                "command": ["foot", "-a", "aichat", "-T", "aichat", "fish", "-C", "exec aichat"]
            }
        }
    }
}
